# ============================================================================
# LORD AI — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# On Vercel, add these as Environment Variables (Project → Settings → Environment Variables).
#
# Client-side variables (prefixed VITE_) are inlined into the browser bundle,
# so they MUST be public keys only. NEVER put a secret behind a VITE_ prefix.
# ============================================================================

# ---- Supabase (Client) -----------------------------------------------------
# Public / publishable Supabase URL and anon key. Safe to expose to the browser.
# Found in: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional alias; VITE_SUPABASE_PUBLISHABLE_KEY takes precedence.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (Server) -----------------------------------------------------
# Used by server routes / server functions and by the AI auth middleware.
# These read process.env at request time (never bundled into the client).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional alias; SUPABASE_PUBLISHABLE_KEY takes precedence.
# SUPABASE_ANON_KEY=your-anon-key

# ---- OpenRouter (Server only) -----------------------------------------------
# Secret API key for the multi-provider LORD AI gateway. Stays server-side;
# never expose to the browser. Get one at https://openrouter.ai/keys
# At least one of the three provider keys below is required for /api/chat.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional OpenRouter HTTP headers (used for usage attribution on openrouter.ai).
# OPENROUTER_REFERER=https://lordai.app
# OPENROUTER_TITLE=LordAI

# ---- Gemini (Server only) ---------------------------------------------------
# Google Gemini API key. When set, Gemini is available as a routing target
# (used first in `balanced` and `fast` modes). Get one at https://aipool.google.
# GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- OpenAI (Server only) ---------------------------------------------------
# OpenAI API key. When set, OpenAI is available as a routing target
# (used first in `quality`/`reasoning` and `coding` modes).
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudflare Workers AI (Server only) ------------------------------------
# Cloudflare account id and API token for the dedicated Cloudflare image
# generation provider (Workers AI). When both are set, users can select
# "cloudflare" as their image provider; the gateway calls the Workers AI REST
# API directly. Create a token with "Account AI" permissions at
# https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional: override the default Workers AI image model
# (default: @cf/black-forest-labs/flux-2-klein-9b)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Provider timeouts (optional). Override the defaults (45s each) if needed.
# GEMINI_TIMEOUT_MS=45000
# OPENROUTER_TIMEOUT_MS=45000
# OPENAI_TIMEOUT_MS=45000

# ---- Optional / Tooling ----------------------------------------------------
# Supabase project id (used by Supabase CLI / Lovable Cloud tooling).
# SUPABASE_PROJECT_ID=your-project-ref
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase service role key — bypasses RLS. Only needed if you use the
# server-side admin client (src/integrations/supabase/client.server.ts).
# Treat as a SECRET. Keep server-side only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase access token for the Supabase CLI (linking / migrations).
# Not used by the running app — keep local only.
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Base URL for API calls from the native (Capacitor) app. Usually left empty
# so the app calls the same origin. Only needed for mobile builds.
# VITE_API_BASE_URL=
